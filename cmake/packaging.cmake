set(CPACK_PACKAGE_VENDOR Gerbera)
set(CPACK_PACKAGE_NAME gerbera)
set(CPACK_PACKAGE_CONTACT "Team Gerbera")
set(CPACK_PACKAGE_VERSION ${GERBERA_VERSION})
set(CPACK_STRIP_FILES YES)

# Debian Specifics
set(CPACK_DEBIAN_UNSPECIFIED_PACKAGE_NAME "Gerbera")
set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
set(CPACK_DEBIAN_PACKAGE_SECTION "net")
set(CPACK_DEBIAN_COMPRESSION_TYPE "xz")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON) # Discover Deps
set(CPACK_DEBIAN_PACKAGE_DEBUG ON)
set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA ${DEBIAN_EXTRA_FILES})
set(CPACK_DEBIAN_PACKAGE_CONTROL_STRICT_PERMISSION ON)

# Enable separate .deb packages per component
set(CPACK_DEB_COMPONENT_INSTALL ON)

# Prevent CPack from merging components into groups
set(CPACK_COMPONENTS_GROUPING IGNORE)

# separate documentation
set(CPACK_DEBIAN_DOCUMENTATION_PACKAGE_NAME "gerbera-doc")
set(CPACK_DEBIAN_DOCUMENTATION_PACKAGE_ARCHITECTURE "all")
set(CPACK_DEBIAN_DOCUMENTATION_SHLIBDEPS OFF)
set(CPACK_DEBIAN_DOCUMENTATION_PACKAGE_SECTION "net")
set(CPACK_DEBIAN_DOCUMENTATION_DESCRIPTION "Documentation for gerbera")

# separate containericons
set(CPACK_DEBIAN_CONTAINERICONS_PACKAGE_NAME "gerbera-container-icons")
set(CPACK_DEBIAN_CONTAINERICONS_PACKAGE_ARCHITECTURE "all")
set(CPACK_DEBIAN_CONTAINERICONS_SHLIBDEPS OFF)
set(CPACK_DEBIAN_CONTAINERICONS_PACKAGE_SECTION "net")
set(CPACK_DEBIAN_CONTAINERICONS_DESCRIPTION "Additional Icons for gerbera")

include(CPack)
